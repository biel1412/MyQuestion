@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="shell">
    <header class="topbar">
        <a class="brand" href="">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 32 32" width="22" height="22"><path fill="currentColor" d="M14 3a11 11 0 0 1 8.7 17.7l5.8 5.8a1.5 1.5 0 0 1-2.1 2.1l-5.8-5.8A11 11 0 1 1 14 3Zm0 3a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm.1 3.2c2 0 3.5 1.2 3.5 3 0 1.3-.7 2-1.7 2.6-.7.4-.9.7-.9 1.3v.3h-2v-.5c0-1.2.5-1.9 1.5-2.5.7-.4 1-.7 1-1.2 0-.6-.6-1-1.4-1-.9 0-1.5.5-1.6 1.3h-2.1c.1-2 1.6-3.3 3.7-3.3Zm-1.2 9.1h2.2v2.1h-2.2v-2.1Z"/></svg>
            </span>
            <span class="brand-text">
                <strong>MyQuestion</strong>
                <small>Assistente da Central de Regramento</small>
            </span>
        </a>

        <nav class="nav">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Consultar</NavLink>
            <NavLink class="nav-link" href="base">Base de regras</NavLink>
            <a class="nav-link" href="https://konigmauricio1-dotcom.github.io/regramentos/" target="_blank" rel="noopener noreferrer">Central ↗</a>
        </nav>

        <button class="icon-button" type="button" @onclick="ToggleTheme" title="Alternar tema" aria-label="Alternar tema claro/escuro">
            @if (theme == "dark")
            {
                <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0-5 1 3h-2l1-3Zm0 20-1-3h2l-1 3ZM2 12l3-1v2l-3-1Zm20 0-3 1v-2l3 1ZM4.9 4.9l2.8 1.4-1.4 1.4-1.4-2.8Zm14.2 14.2-2.8-1.4 1.4-1.4 1.4 2.8Zm0-14.2-1.4 2.8-1.4-1.4 2.8-1.4ZM4.9 19.1l1.4-2.8 1.4 1.4-2.8 1.4Z"/></svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M20.7 14.6A8.5 8.5 0 0 1 9.4 3.3a9 9 0 1 0 11.3 11.3Z"/></svg>
            }
        </button>
    </header>

    <main class="content">
        @Body
    </main>

    <footer class="footer">
        <span>O texto dos prints é lido no seu navegador. Nenhuma imagem é enviada para servidor.</span>
        <span>Base de manuais: <a href="https://konigmauricio1-dotcom.github.io/regramentos/" target="_blank" rel="noopener noreferrer">Central de Regramento</a></span>
    </footer>
</div>

@code {
    private string theme = "dark";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        theme = await JS.InvokeAsync<string>("myq.getTheme");
        StateHasChanged();
    }

    private async Task ToggleTheme()
    {
        theme = theme == "dark" ? "light" : "dark";
        await JS.InvokeVoidAsync("myq.setTheme", theme);
    }
}
